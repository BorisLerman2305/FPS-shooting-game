# Copy to .env for local dev (or set on Railway in production).

# Postgres connection string. Railway injects this automatically when you
# reference the Postgres add-on with `${{Postgres.DATABASE_URL}}`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fps_game

# Secret used to sign JWTs. MUST be replaced with a strong random string in
# production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Server port. Railway sets this automatically.
PORT=3001
